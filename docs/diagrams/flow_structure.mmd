flowchart TD

    %% Left side: patient workflow
    Start((Start))
    CP[Patient erstellen]
    PE[Patientenuntersuchung]
    PF[Patientenbefund]
    PCC[patientenbezogene Klassifikationsauswahl]

    Start --> CP
    CP --> PE
    PE --> PF
    PF --> PCC

    %% Right side: medical knowledge
    KB[Wissensbasis]
    EX[Untersuchung]
    FI[Befund]
    CL[Klassifikation]
    CC[Klassifikationsauswahl]

    KB --> EX
    KB --> FI
    KB --> CL
    CL --> CC

    %% Cross-links between knowledge and patient data
    EX --> PE
    FI --> PF
    CC --> PCC
