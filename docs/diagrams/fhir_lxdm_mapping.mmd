  subgraph ADAPTER["LXDM FHIR adapter"]
    PATTERN_Patient_and_case_context["Patient and case context<br/><small>Patient.identifier/name/birthDate/gender/contact → Patient identity and demographics<br/>Encounter.subject/period → Case membership and dates<br/>Patient.managingOrganization + Encounter.serviceProvider → Center relationship (resolved by references)</small>"]
    PATTERN_Examination_and_report_context["Examination and report context<br/><small>Procedure.code/subject/encounter/performed[x] → PExamination examination/patient/case/date<br/>DiagnosticReport.code/effective[x]/result → PExamination report context and finding links</small>"]
    PATTERN_Clinical_indication["Clinical indication<br/><small>ServiceRequest.code/reasonCode/reasonReference → PIndication concept and classifications<br/>Referenced Condition or Observation → PIndication clinical reason (terminology and profile dependent)</small>"]
    PATTERN_Clinical_finding["Clinical finding<br/><small>Observation.code/value[x]/component → PFinding and classifications<br/>Condition.code/clinicalStatus → PFinding and status classification<br/>DiagnosticReport.result → PExamination-to-finding links (reference resolution)</small>"]
    PATTERN_Finding_related_intervention["Finding-related intervention<br/><small>Procedure.code/bodySite/reasonReference → Intervention concept and finding relation (primary performed-action context)<br/>MedicationAdministration.medication[x]/effective[x] → Medication detail (only when medication was administered)<br/>Procedure.focalDevice/usedReference + Device → Device detail (only when a device is clinically relevant)<br/>DiagnosticReport.specimen + Specimen → Specimen context (only for sampling interventions)</small>"]
    PATTERN_Performer_and_center_context["Performer and center context<br/><small>Procedure.performer.actor → Examiner relation (reference resolution)<br/>Practitioner + PractitionerRole → Examiner identity and role<br/>PractitionerRole.organization + Organization → Center</small>"]
  end
